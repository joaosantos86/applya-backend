# =============================================================================
# Applya Backend — variáveis de ambiente
# Copie para .env (ignorado pelo Git) e ajuste os valores locais.
# Nenhum valor real de credencial deve ser commitado.
# =============================================================================

# Ambiente de execução: development | test | production
APP_ENV=development

# Porta TCP do servidor HTTP
HTTP_PORT=8080

# String de conexão do PostgreSQL (obrigatória)
DATABASE_URL=postgres://applya:applya@localhost:5432/applya?sslmode=disable

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# Origens do frontend autorizadas (separadas por vírgula). "*" é rejeitado.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Origem do frontend usada nos links de confirmação/redefinição de senha
# enviados por e-mail (obrigatória)
FRONTEND_URL=http://localhost:5173

# Tempo de vida das sessões de login (formato Go, ex.: 24h, 168h, 720h)
SESSION_DURATION=720h

# Provedor de e-mail transacional: log | resend | smtp
#   log    = não envia de verdade; registra o e-mail no log (apenas dev/testes)
#   resend = envia pela API HTTP do Resend (https://resend.com)
#   smtp   = envia por SMTP com STARTTLS (ex.: Gmail com senha de app)
EMAIL_PROVIDER=log

# Chave da API do Resend (obrigatória quando EMAIL_PROVIDER=resend)
EMAIL_API_KEY=

# Remetente dos e-mails transacionais (obrigatório quando EMAIL_PROVIDER=resend)
EMAIL_FROM=Applya <no-reply@applya.dev>

# SMTP (obrigatório quando EMAIL_PROVIDER=smtp). Use a porta 587 com STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Atributo SameSite dos cookies de autenticação: lax | strict | none
#   lax   = padrão; use quando frontend e API compartilham o mesmo site
#   none  = necessário quando frontend e API vivem em domínios diferentes
#           (força Secure automaticamente)
COOKIE_SAMESITE=lax

# Confia em headers X-Forwarded-For para identificar o IP do cliente.
#   false = padrão, seguro para acesso direto (ignora headers forjáveis)
#   true  = use apenas quando a API está atrás de um proxy confiável (Render),
#           que sobrescreve o header a cada requisição
TRUST_PROXY_HEADERS=false
