# Copie estes valores para o seu .env para usar Gmail SMTP em desenvolvimento
# ou produção. Não versione o .env preenchido.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=COLOQUE_SEU_GMAIL_AQUI
SMTP_PASSWORD=COLE_A_SENHA_DE_APP_AQUI
EMAIL_FROM=Applya <COLOQUE_SEU_GMAIL_AQUI>
